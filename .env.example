# 이 파일을 복사해 이름을 .env 로 바꾸고, 필요한 값만 채우세요. (.env 는 깃허브에 올리지 않습니다)
# 아무것도 채우지 않아도 화면(run.bat)은 저장소의 data/ 로 동작합니다.

# AI 에이전트 자유 질문 (없으면 질문 버튼·검색·보고서만 동작)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# 운영사 화면의 텔레그램 알림 발송 (없으면 버튼만 보이고 발송은 안 됨)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 데이터를 직접 수집할 때만 필요
# KECO_KEY : 공공데이터포털 '한국환경공단_전기자동차 충전소 정보' 일반 인증키(Decoding) → python collect.py
# HUB_KEY  : 제주데이터허브 API 키 → python hub_stations.py
KECO_KEY=
HUB_KEY=
